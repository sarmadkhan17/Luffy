+++ b/frontend/tests/browser/close-trade.spec.ts
@@ -0,0 +1,337 @@
+import { test, expect, type Page, type Request } from "@playwright/test";
+import { LIVE, H, login, state, calls } from "./liveHelpers";
+
+// LIVE build over the real FastAPI app (auth Guard, GraphQL close_trade
+// mutation, dashboard gateway adapter) and a fake kernel Owner Interface that
+// honors OwnerService._close_trade: the exact journal id must be open and is
+// queued once. Fixture book: t-btc (BTC long 0.01), t-eth (ETH short 0.5) open;
+// t-old (SOL) closed. Control state FROZEN.
+
+type Call = {
+  operation: string;
+  request_id: string;
+  args: { trade_id?: string };
+};
+const closeCalls = async (request: Parameters<typeof calls>[0]) =>
+  ((await calls(request)).gateway as Call[]).filter(
+    (c) => c.operation === "close_trade",
+  );
+const queued = async (request: Parameters<typeof calls>[0]) =>
+  JSON.parse((await calls(request)).close_requests ?? "[]");
+
+const book = (page: Page) =>
+  page.locator("section").filter({
+    has: page.getByRole("heading", { name: "Trade book", exact: true }),
+  });
+async function openTrades(page: Page) {
+  await login(page);
+  await page.getByRole("link", { name: "Trades", exact: true }).click();
+  await expect(page.getByTestId("trade-range")).toContainText("Records 1–");
+}
+async function inspect(page: Page, symbol: string) {
+  await book(page)
+    .getByRole("button", { name: `Inspect ${symbol}` })
+    .click();
+  const d = page.getByRole("dialog", { name: symbol });
+  await expect(d).toBeVisible();
+  return d;
+}
+async function closeRecord(page: Page) {
+  await page.getByRole("button", { name: "Close record" }).click();
+}
+async function confirmClose(page: Page, symbol = "BTC/USDT") {
+  const d = await inspect(page, symbol);
+  await expect(d.getByRole("button", { name: "Close Trade" })).toBeEnabled();
+  await d.getByRole("button", { name: "Close Trade" }).click();
+  await page.getByRole("button", { name: "Send close to LUFFY" }).click();
+}
+const outcome = (page: Page) => page.getByTestId("close-outcome");
+const isCloseMutation = (r: Request) =>
+  r.url().endsWith("/graphql") && (r.postData() ?? "").includes("close_trade(");
+
+test.beforeEach(async ({ request, page }) => {
+  await state(request, {
+    scenario: "normal",
+    gateway: "up",
+    chat: "ok",
+    fail: [],
+    ttl: 43200,
+    reset_calls: true,
+  });
+  await page.addInitScript(() => {
+    if (!sessionStorage.getItem("close-spec")) {
+      localStorage.clear(); // no unresolved request from an earlier test
+      sessionStorage.setItem("close-spec", "1");
+    }
+  });
+});
+test.afterAll(async ({ request }) => {
+  await state(request, { scenario: "normal", gateway: "up", fail: [] });
+});
+
+test("open trade offers Close Trade behind a confirmation; closed does not; cancel sends nothing", async ({
+  page,
+  request,
+}) => {
+  await openTrades(page);
+  // never on a table row
+  await expect(
+    book(page).locator("table").getByRole("button", { name: /close/i }),
+  ).toHaveCount(0);
+  const sol = await inspect(page, "SOL/USDT");
+  await expect(sol.getByRole("button", { name: "Close Trade" })).toHaveCount(0);
+  await closeRecord(page);
+  const btc = await inspect(page, "BTC/USDT");
+  await btc.getByRole("button", { name: "Close Trade" }).click();
+  const confirm = page.getByRole("dialog", { name: "Confirm close trade" });
+  await expect(confirm).toContainText(
+    "This sends a real owner control to LUFFY",
+  );
+  const fields = confirm.getByTestId("close-confirm-fields");
+  await expect(fields).toContainText("SymbolBTC/USDT");
+  await expect(fields).toContainText("Sidelong");
+  await expect(fields).toContainText("Open quantity (journal)0.01");
+  await expect(fields).toContainText("Trade IDt-btc");
+  await expect(fields).toContainText("Control stateFROZEN");
+  await confirm.getByRole("button", { name: "Cancel", exact: true }).click();
+  await expect(confirm).toHaveCount(0);
+  await expect(outcome(page)).toHaveCount(0);
+  expect(await closeCalls(request)).toEqual([]);
+  expect(await queued(request)).toEqual([]);
+});
+
+test("sends the exact trade id once and shows the kernel's answer, not a closed trade", async ({
+  page,
+  request,
+}) => {
+  const offOrigin: string[] = [];
+  page.on("request", (r) => {
+    if (new URL(r.url()).origin !== LIVE) offOrigin.push(r.url());
+  });
+  await state(request, { gateway: "slow" }); // 1.5 s kernel answer
+  await openTrades(page);
+  await confirmClose(page);
+  const busy = page.getByRole("button", {
+    name: /Close pending|Checking trade/,
+  });
+  await expect(busy).toBeDisabled();
+  await expect(page.getByTestId("close-pending")).toBeVisible();
+  await busy.click({ force: true }); // disabled: no second submission
+  await busy.dblclick({ force: true });
+  await expect(outcome(page)).toContainText(
+    "close_trade: ACCEPTED · COMPLETED",
+  );
+  await expect(outcome(page)).toContainText("It is NOT closed yet");
+  const sent = await closeCalls(request);
+  expect(sent).toHaveLength(1);
+  expect(sent[0].args).toEqual({ trade_id: "t-btc" });
+  expect(await queued(request)).toEqual(["t-btc"]); // never its neighbour
+  // the journal still says open; the page does not pretend otherwise
+  await closeRecord(page);
+  await expect(
+    book(page).locator("tbody tr").filter({ hasText: "BTC/USDT" }),
+  ).toContainText("open");
+  expect(offOrigin).toEqual([]); // no venue or third-party call
+});
+
+test("under HALTED the existing contract still queues an owner close", async ({
+  page,
+  request,
+}) => {
+  const r = await request.post(LIVE + "/graphql", {
+    headers: H,
+    data: {
+      query:
+        'mutation($r:String!,$t:Float!){owner_control(operation:"halt",request_id:$r,issued_at_ms:$t){status}}',
+      variables: { r: "halt-for-close-spec-0001", t: Date.now() },
+    },
+  });
+  expect((await r.json()).data.owner_control.status).toBe("ACCEPTED");
+  await openTrades(page);
+  const d = await inspect(page, "ETH/USDT");
+  await d.getByRole("button", { name: "Close Trade" }).click();
+  await expect(page.getByTestId("close-confirm-fields")).toContainText(
+    "Control stateHALTED",
+  );
+  await page.getByRole("button", { name: "Send close to LUFFY" }).click();
+  await expect(outcome(page)).toContainText("close_trade: ACCEPTED");
+  expect(await queued(request)).toEqual(["t-eth"]);
+});
+
+test("a refusal is shown as not executed", async ({ page, request }) => {
+  await state(request, { gateway: "refuse" });
+  await openTrades(page);
+  await confirmClose(page);
+  await expect(outcome(page)).toContainText("close_trade: REFUSED · REFUSED");
+  await expect(outcome(page)).toContainText("operation_not_permitted");
+  await expect(outcome(page)).toContainText("will not execute");
+  expect(await queued(request)).toEqual([]);
+});
+
+test("kernel unavailable: disabled when known, UNAVAILABLE on send, same id on retry", async ({
+  page,
+  request,
+}) => {
+  await state(request, { gateway: "down" });
+  await openTrades(page);
+  let d = await inspect(page, "BTC/USDT");
+  await expect(d.getByTestId("close-unavailable")).toContainText(
+    "Kernel Owner Interface unavailable (kernel_unavailable)",
+  );
+  await expect(d.getByRole("button", { name: "Close Trade" })).toBeDisabled();
+  await closeRecord(page);
+  // up when shown, down when sent
+  await state(request, { gateway: "up" });
+  d = await inspect(page, "BTC/USDT");
+  await expect(d.getByRole("button", { name: "Close Trade" })).toBeEnabled();
+  await d.getByRole("button", { name: "Close Trade" }).click();
+  await state(request, { gateway: "down" });
+  await page.getByRole("button", { name: "Send close to LUFFY" }).click();
+  await expect(outcome(page)).toContainText("close_trade: UNAVAILABLE");
+  await expect(outcome(page)).toContainText("Nothing changed");
+  expect(await queued(request)).toEqual([]);
+  await state(request, { gateway: "up" });
+  await closeRecord(page);
+  d = await inspect(page, "BTC/USDT");
+  await d.getByRole("button", { name: "Retry close (same request)" }).click();
+  await expect(outcome(page)).toContainText("close_trade: ACCEPTED");
+  const sent = await closeCalls(request);
+  expect(sent).toHaveLength(2);
+  expect(sent[1].request_id).toBe(sent[0].request_id);
+  expect(await queued(request)).toEqual(["t-btc"]);
+});
+
+test("a trade closed since display is not sent and the book refreshes", async ({
+  page,
+  request,
+}) => {
+  await openTrades(page);
+  const d = await inspect(page, "BTC/USDT");
+  await d.getByRole("button", { name: "Close Trade" }).click();
+  await state(request, { close_trade: "t-btc" }); // closed by the kernel meanwhile
+  await page.getByRole("button", { name: "Send close to LUFFY" }).click();
+  await expect(outcome(page)).toContainText(
+    "This trade is no longer open in the journal. Nothing was sent",
+  );
+  // the refreshed record is closed: its answer stays, the close control goes
+  await expect(page.getByTestId("close-trade-closed")).toContainText(
+    "This trade is closed in the journal",
+  );
+  await expect(page.getByRole("button", { name: "Close Trade" })).toHaveCount(0);
+  expect(await closeCalls(request)).toEqual([]);
+  await closeRecord(page);
+  await expect(
+    book(page).locator("tbody tr").filter({ hasText: "BTC/USDT" }),
+  ).toContainText("closed");
+});
+
+test("a trade the kernel finds closed is refused as trade_not_open", async ({
+  page,
+  request,
+}) => {
+  await state(request, { gateway: "race_close" });
+  await openTrades(page);
+  await confirmClose(page);
+  await expect(outcome(page)).toContainText("close_trade: REFUSED");
+  await expect(outcome(page)).toContainText(
+    "this trade is not open (already closed)",
+  );
+  expect(await queued(request)).toEqual([]);
+});
+
+test("outcome unknown keeps the id; an exact replay returns the recorded result", async ({
+  page,
+  request,
+}) => {
+  // 1) kernel reports OUTCOME_UNKNOWN
+  await state(request, { gateway: "unknown_once" });
+  await openTrades(page);
+  await confirmClose(page);
+  await expect(outcome(page)).toContainText("close_trade: OUTCOME_UNKNOWN");
+  await expect(outcome(page)).toContainText("Do not assume either");
+  // 2) the answer to the retry is lost in transit AFTER the kernel ran it
+  let lost = false;
+  await page.route("**/graphql", async (route) => {
+    if (!isCloseMutation(route.request()) || lost) return route.continue();
+    lost = true;
+    await route.fetch(); // reaches the server and executes
+    await route.abort("timedout");
+  });
+  await page
+    .getByRole("button", { name: "Retry close (same request)" })
+    .click();
+  await expect(outcome(page)).toContainText("No answer — outcome unknown");
+  expect(await queued(request)).toEqual(["t-btc"]);
+  // 3) the same id again: the recorded result, no second close
+  await page
+    .getByRole("button", { name: "Retry close (same request)" })
+    .click();
+  await expect(outcome(page)).toContainText("close_trade: ACCEPTED");
+  await expect(outcome(page)).toContainText("recorded result (replay)");
+  const sent = await closeCalls(request);
+  expect(sent).toHaveLength(3);
+  expect(new Set(sent.map((c) => c.request_id)).size).toBe(1);
+  expect(await queued(request)).toEqual(["t-btc"]);
+  await expect(
+    page.getByRole("button", { name: "Retry close (same request)" }),
+  ).toHaveCount(0);
+});
+
+test("session expiry during send keeps the request for the next sign-in", async ({
+  page,
+  request,
+}) => {
+  await page.route("**/graphql", async (route) => {
+    if (!isCloseMutation(route.request())) return route.continue();
+    // the session is gone when the mutation arrives: the real server's
+    // answer to this same mutation without the session cookie
+    const response = await request.post(LIVE + "/graphql", {
+      headers: { origin: LIVE },
+      data: route.request().postDataJSON(),
+    });
+    await route.fulfill({ response });
+  });
+  await openTrades(page);
+  await confirmClose(page);
+  await expect(page.getByTestId("signed-out")).toBeVisible();
+  expect(await closeCalls(request)).toEqual([]); // refused at the Guard
+  await page.unroute("**/graphql");
+  await page.context().clearCookies(); // the expired session, as the server saw it
+  await openTrades(page);
+  const d = await inspect(page, "BTC/USDT");
+  await expect(d.getByTestId("close-unresolved")).toContainText(
+    "Unresolved close request",
+  );
+  await d.getByRole("button", { name: "Retry close (same request)" }).click();
+  await expect(outcome(page)).toContainText("close_trade: ACCEPTED");
+  expect(await closeCalls(request)).toHaveLength(1);
+});
+
+test("a late answer never lands on the trade now selected", async ({
+  page,
+  request,
+}) => {
+  let release!: () => void;
+  const held = new Promise<void>((r) => (release = r));
+  await page.route("**/graphql", async (route) => {
+    if (!isCloseMutation(route.request())) return route.continue();
+    await held;
+    await route.continue();
+  });
+  await openTrades(page);
+  await confirmClose(page, "BTC/USDT");
+  await expect(page.getByTestId("close-pending")).toBeVisible();
+  await closeRecord(page);
+  const eth = await inspect(page, "ETH/USDT");
+  release();
+  await expect.poll(async () => (await closeCalls(request)).length).toBe(1);
+  await page.waitForTimeout(300);
+  await expect(eth.getByTestId("close-outcome")).toHaveCount(0);
+  await expect(eth.getByRole("button", { name: "Close Trade" })).toBeEnabled();
+  await closeRecord(page);
+  const btc = await inspect(page, "BTC/USDT");
+  await expect(btc.getByTestId("close-outcome")).toContainText(
+    "close_trade: ACCEPTED",
+  );
+  expect(await queued(request)).toEqual(["t-btc"]);
+});
