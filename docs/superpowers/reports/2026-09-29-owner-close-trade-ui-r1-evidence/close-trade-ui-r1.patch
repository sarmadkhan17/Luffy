+            status: "ACCEPTED",
+            disposition: "COMPLETED",
+            reasons: ["close_queued_next_cycle"],
+            audit_event_ids: [1, 2],
+            replayed: false,
+            message: "Close queued — next cycle.",
+          },
+        },
+      }),
+    });
+    vi.stubGlobal("fetch", fetch);
+    const r = await createLiveAdapter(() => {}).closeTrade!("t-btc", req);
+    expect(r).toMatchObject({ status: "ACCEPTED", operation: "close_trade" });
+    expect(fetch).toHaveBeenCalledTimes(1);
+    const [url, init] = fetch.mock.calls[0];
+    expect(url).toBe("/graphql");
+    expect(init.method).toBe("POST");
+    expect(init.credentials).toBe("same-origin");
+    expect(JSON.parse(init.body)).toEqual({
+      query: CLOSE_TRADE_MUTATION,
+      variables: { x: "t-btc", r: req.id, t: req.t },
+    });
+  });
+  it.each([
+    ["transport failure", () => Promise.reject(new TypeError("net"))],
+    [
+      "GraphQL error without a result",
+      () =>
+        Promise.resolve({
+          ok: true,
+          status: 200,
+          json: async () => ({ errors: [{ message: "x" }], data: null }),
+        }),
+    ],
+    [
+      "an answer for another operation",
+      () =>
+        Promise.resolve({
+          ok: true,
+          status: 200,
+          json: async () => ({
+            data: { res: { operation: "panic", status: "ACCEPTED" } },
+          }),
+        }),
+    ],
+  ])("%s → null (outcome unknown), never success or failure", async (_n, f) => {
+    vi.stubGlobal("fetch", vi.fn(f));
+    expect(
+      await createLiveAdapter(() => {}).closeTrade!("t-btc", req),
+    ).toBeNull();
+  });
+  it("a 401 is session expiry, not an outcome", async () => {
+    const onUnauthorized = vi.fn();
+    vi.stubGlobal(
+      "fetch",
+      vi
+        .fn()
+        .mockResolvedValue({ ok: false, status: 401, json: async () => ({}) }),
+    );
+    await expect(
+      createLiveAdapter(onUnauthorized).closeTrade!("t-btc", req),
+    ).rejects.toBeInstanceOf(SessionExpired);
+    expect(onUnauthorized).toHaveBeenCalled();
+  });
+  it("frontend source contains no venue endpoint or exchange client", () => {
+    const files: string[] = [];
+    const walk = (d: string) => {
+      for (const f of readdirSync(d)) {
+        const p = join(d, f);
+        if (statSync(p).isDirectory()) walk(p);
+        else if (/\.(ts|tsx)$/.test(f)) files.push(p);
+      }
+    };
+    walk(join(__dirname, "../src"));
+    for (const f of files) {
+      const text = readFileSync(f, "utf8");
+      expect(text, f).not.toMatch(
+        /binance\.com|binancefuture|fapi\.|ccxt|create_order|createOrder/i,
+      );
+    }
+  });
+});
diff --git a/frontend/tests/browser/close-trade.spec.ts b/frontend/tests/browser/close-trade.spec.ts
