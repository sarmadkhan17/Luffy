diff --git a/frontend/src/views/CloseTrade.tsx b/frontend/src/views/CloseTrade.tsx
new file mode 100644
index 0000000..d736893
--- /dev/null
+++ b/frontend/src/views/CloseTrade.tsx
@@ -0,0 +1,435 @@
+/** Close ONE open trade through the kernel's typed Owner Interface intent
+ * (GraphQL close_trade → dashboard gateway → OwnerService._close_trade → the
+ * kernel's close queue → Executor.close on its next cycle).
+ *
+ * The browser never places an order and never writes the journal. It names the
+ * trade by its immutable journal id; the kernel checks the id is still open.
+ * Before a NEW request is sent, the displayed trade is re-read from the open
+ * trade book and must still be the same open trade (symbol, side, quantity);
+ * any difference sends nothing and refreshes. Each intended close has one
+ * request id + issue time (shared "luffy.owner.req." protocol, action
+ * "close_trade:<id>"), reused until the kernel gives a definitive answer. */
+import { useRef, useState } from "react";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import * as Dialog from "@radix-ui/react-dialog";
+import { X } from "lucide-react";
+import { usePreview } from "../context";
+import * as pending from "../adapters/pending";
+import { SessionExpired } from "../adapters/live";
+import type { ControlResult, PendingRequest } from "../adapters/contracts";
+import { value } from "../components/workspace";
+import { timestamp as utc } from "../time";
+
+/** The trade exactly as the owner saw it when confirming. */
+export interface ShownTrade {
+  id: string;
+  symbol: string;
+  side: string;
+  amount: unknown;
+}
+export type CloseOutcome =
+  | { kind: "answer"; result: ControlResult; request: PendingRequest }
+  | { kind: "unknown"; request: PendingRequest }
+  /** request null: the session ended before anything was sent. */
+  | { kind: "session"; request: PendingRequest | null }
+  | {
+      kind: "stale";
+      reason: "not_open" | "changed" | "unverifiable" | "read_failed";
+      detail?: string;
+    };
+export const closeAction = (tradeId: string) => `close_trade:${tradeId}`;
+/** Largest page the trades endpoint serves; open trades are far fewer. */
+const OPEN_READ_LIMIT = 200;
+const same = (a: unknown, b: unknown) => value(a) === value(b);
+
+/** Per-trade close state, owned above the (unmounting) record drawer so a
+ * late answer lands on its own trade and never on the one now on screen. */
+export function useCloseTrades() {
+  const { adapter } = usePreview();
+  const qc = useQueryClient();
+  const busy = useRef(new Set<string>());
+  const [inFlight, setInFlight] = useState<
+    Record<string, "verifying" | "sending">
+  >({});
+  const [outcomes, setOutcomes] = useState<Record<string, CloseOutcome>>({});
+  const [storageWarning, setStorageWarning] = useState(false);
+  const mark = (id: string, phase: "verifying" | "sending" | null) =>
+    setInFlight((m) => {
+      const n = { ...m };
+      if (phase) n[id] = phase;
+      else delete n[id];
+      return n;
+    });
+  const settle = (id: string, o: CloseOutcome) =>
+    setOutcomes((m) => ({ ...m, [id]: o }));
+  const refresh = () => {
+    void qc.invalidateQueries({ queryKey: ["trades"] });
+    void qc.invalidateQueries({ queryKey: ["overview"] });
+    void qc.invalidateQueries({ queryKey: ["owner-interface"] });
+  };
+
+  /** Re-read the open book: is the shown trade still that same open trade? */
+  async function verify(shown: ShownTrade): Promise<CloseOutcome | null> {
+    let page;
+    try {
+      page = await adapter.tradePage!(
+        { status: "open", cursor: null, limit: OPEN_READ_LIMIT },
+        new AbortController().signal,
+      );
+    } catch (e) {
+      if (e instanceof SessionExpired) throw e;
+      return {
+        kind: "stale",
+        reason: "read_failed",
+        detail: (e as Error).message,
+      };
+    }
+    const now = page.rows.find((r) => String(r.id) === shown.id);
+    if (!now)
+      return page.hasMore
+        ? { kind: "stale", reason: "unverifiable" }
+        : { kind: "stale", reason: "not_open" };
+    if (
+      now.status !== "open" ||
+      !same(now.symbol, shown.symbol) ||
+      !same(now.side, shown.side) ||
+      !same(now.amount, shown.amount)
+    )
+      return {
+        kind: "stale",
+        reason: "changed",
+        detail: `now ${value(now.symbol)} ${value(now.side)} ${value(now.amount)}`,
+      };
+    return null;
+  }
+
+  async function send(tradeId: string, request: PendingRequest) {
+    mark(tradeId, "sending");
+    try {
+      const result = await adapter.closeTrade!(tradeId, request);
+      if (result && pending.DEFINITIVE.includes(result.status))
+        pending.done(request.id);
+      settle(
+        tradeId,
+        result
+          ? { kind: "answer", result, request }
+          : { kind: "unknown", request },
+      );
+    } catch (e) {
+      // the id is kept either way: nothing here can establish the outcome
+      settle(
+        tradeId,
+        e instanceof SessionExpired
+          ? { kind: "session", request }
+          : { kind: "unknown", request },
+      );
+    }
+  }
+
+  /** A NEW close: verify freshness, then create one request id and send. */
+  async function submit(shown: ShownTrade) {
+    if (busy.current.has(shown.id)) return; // double click / double submit
+    busy.current.add(shown.id);
+    try {
+      const existing = pending.find(closeAction(shown.id));
+      if (existing) return await send(shown.id, existing);
+      mark(shown.id, "verifying");
+      let stale: CloseOutcome | null;
+      try {
+        stale = await verify(shown);
+      } catch {
+        // verify maps every other failure itself; only SessionExpired escapes
+        return settle(shown.id, { kind: "session", request: null });
+      }
+      if (stale) return settle(shown.id, stale); // nothing sent
+      const { entry, durable } = pending.create(closeAction(shown.id));
+      if (!durable) setStorageWarning(true);
+      await send(shown.id, entry);
+    } finally {
+      busy.current.delete(shown.id);
+      mark(shown.id, null);
+      refresh();
+    }
+  }
+
+  /** Re-send an unresolved request: same id and issue time, no new action. */
+  async function retry(tradeId: string) {
+    const existing = pending.find(closeAction(tradeId));
+    if (!existing || busy.current.has(tradeId)) return;
+    busy.current.add(tradeId);
+    try {
+      await send(tradeId, existing);
+    } finally {
+      busy.current.delete(tradeId);
+      mark(tradeId, null);
+      refresh();
+    }
+  }
+  return { inFlight, outcomes, storageWarning, submit, retry };
+}
+export type CloseTrades = ReturnType<typeof useCloseTrades>;
+
+const STALE_TEXT: Record<string, string> = {
+  not_open:
+    "This trade is no longer open in the journal. Nothing was sent; the trade book was refreshed.",
+  changed:
+    "This trade changed since it was displayed. Nothing was sent; the trade book was refreshed — review it and confirm again.",
+  unverifiable:
+    "The open trade book is larger than one read, so this trade could not be re-verified. Nothing was sent.",
+  read_failed:
+    "The current trade state could not be read. Nothing was sent; retry when the backend answers.",
+};
+
+function answerText(r: ControlResult): string {
+  if (r.status === "ACCEPTED")
+    return "The kernel accepted and queued this close. It is NOT closed yet: the kernel market-closes it on its next cycle, and the trade book shows it closed only after the kernel books the exit.";
+  if (r.status === "ALREADY_SET")
+    return "A close for this trade was already queued in the kernel. Nothing new was queued; it is not closed until the kernel books the exit.";
+  if (r.status === "REFUSED")
+    return r.reasons.includes("trade_not_open")
+      ? "Refused by the kernel: this trade is not open (already closed). Nothing was sent to the venue."
+      : "Refused by the kernel. It was not executed and will not execute.";
+  if (r.status === "UNAVAILABLE")
+    return "Not delivered — the kernel Owner Interface is unavailable. Nothing changed. Retry sends the same request id.";
+  if (r.status === "IN_PROGRESS")
+    return "The kernel is still processing this request. Retry sends the same request id to read its outcome.";
+  return "Outcome UNKNOWN: the close may or may not have been queued. Do not assume either. Retry sends the same request id to resolve it without a second close.";
+}
+
+export function CloseTradePanel({
+  row,
+  closes,
+}: {
+  row: Record<string, unknown>;
+  closes: CloseTrades;
+}) {
+  const { adapter } = usePreview();
+  const health = useQuery({
+    queryKey: ["owner-interface"],
+    queryFn: ({ signal }) => adapter.ownerInterface!(signal),
+    enabled: !!adapter.ownerInterface,
+    staleTime: 0,
+  });
+  const [confirming, setConfirming] = useState<ShownTrade | null>(null);
+  if (!adapter.closeTrade || !adapter.tradePage) return null;
+  const id = String(row.id);
+  const open = row.status === "open";
+  const phase = closes.inFlight[id];
+  const outcome = closes.outcomes[id];
+  const unresolved = pending.find(closeAction(id));
+  // A closed trade offers no close. It still shows this session's answer and
+  // an unresolved request, whose outcome only a same-id retry can establish.
+  if (!open && !phase && !outcome && !unresolved) return null;
+  const available =
+    !!adapter.ownerInterface &&
+    health.data?.availability === "AVAILABLE" &&
+    !health.isFetching;
+  const controlState = health.data?.controlState ?? null;
+  return (
+    <section
+      className="close-trade"
+      aria-label="Close this trade"
+      data-testid="close-trade"
+    >
+      <h3>Owner control</h3>
+      {unresolved ? (
+        <>
+          <button
+            type="button"
+            className="danger"
+            disabled={!!phase || !available}
+            onClick={() => void closes.retry(id)}
+          >
+            {phase ? "Close pending…" : "Retry close (same request)"}
+          </button>
+          <p className="quiet" data-testid="close-unresolved">
+            Unresolved close request {unresolved.id} issued{" "}
+            {utc(new Date(unresolved.t).toISOString())}. Retry re-sends that
+            same request id; it can never queue a second close.
+          </p>
+        </>
+      ) : !open ? (
+        <p className="quiet" data-testid="close-trade-closed">
+          This trade is {String(row.status ?? "not open")} in the journal as of
+          this read; it offers no close.
+        </p>
+      ) : (
+        <button
+          type="button"
+          className="danger"
+          disabled={!!phase || !available}
+          onClick={() =>
+            setConfirming({
+              id,
+              symbol: String(row.symbol ?? ""),
+              side: String(row.side ?? ""),
+              amount: row.amount,
+            })
+          }
+        >
+          {phase === "verifying"
+            ? "Checking trade…"
+            : phase === "sending"
+              ? "Close pending…"
+              : "Close Trade"}
+        </button>
+      )}
+      {phase && (
+        <p role="status" data-testid="close-pending">
+          {phase === "verifying"
+            ? "Re-reading this trade before sending…"
+            : "Close request sent to the kernel Owner Interface — waiting for its answer."}
+        </p>
+      )}
+      {!available && !phase && (open || unresolved) && (
+        <p role="status" data-testid="close-unavailable">
+          {health.isPending || health.isFetching
+            ? "Checking the kernel Owner Interface…"
+            : health.error
+              ? `Owner Interface health read failed: ${(health.error as Error).message} Close is disabled.`
+              : `Kernel Owner Interface unavailable (${health.data?.reasons.join(", ") || "no reason"}). Close is disabled — nothing is sent while the kernel cannot receive it.`}
+        </p>
+      )}
+      {closes.storageWarning && (
+        <p role="alert">
+          Browser storage unavailable: an unresolved close request is kept only
+          until this page reloads.
+        </p>
+      )}
+      {outcome && <Outcome outcome={outcome} />}
+      <Dialog.Root
+        open={!!confirming}
+        onOpenChange={(o) => !o && setConfirming(null)}
+      >
+        <Dialog.Portal>
+          <Dialog.Overlay className="dialog-overlay" />
+          <Dialog.Content className="evidence-drawer confirm-dialog">
+            <div className="panel-heading">
+              <Dialog.Title>Confirm close trade</Dialog.Title>
+              <Dialog.Close className="icon-button" aria-label="Cancel close">
+                <X size={20} />
+              </Dialog.Close>
+            </div>
+            <Dialog.Description>
+              This sends a real owner control to LUFFY. The kernel checks the
+              trade is still open and market-closes this one trade with a
+              reduce-only order on its next cycle.
+            </Dialog.Description>
+            <dl className="record-fields" data-testid="close-confirm-fields">
+              <div>
+                <dt>Symbol</dt>
+                <dd>{confirming?.symbol}</dd>
+              </div>
+              <div>
+                <dt>Side</dt>
+                <dd>{confirming?.side}</dd>
+              </div>
+              <div>
+                <dt>Open quantity (journal)</dt>
+                <dd>{value(confirming?.amount)}</dd>
+              </div>
+              <div>
+                <dt>Trade ID</dt>
+                <dd>{confirming?.id}</dd>
+              </div>
+              <div>
+                <dt>Control state</dt>
+                <dd>{controlState ?? "unknown"}</dd>
+              </div>
+            </dl>
+            <p className="quiet">
+              The kernel queues an owner close in any control state (ACTIVE,
+              FROZEN or HALTED). Before sending, this trade is re-read; if it
+              changed or is no longer open, nothing is sent.
+            </p>
+            <div className="composer-actions space-top">
+              <Dialog.Close className="button secondary">Cancel</Dialog.Close>
+              <button
+                type="button"
+                className="danger"
+                disabled={!available || !!phase}
+                onClick={() => {
+                  const shown = confirming;
+                  setConfirming(null);
+                  if (shown) void closes.submit(shown);
+                }}
+              >
+                Send close to LUFFY
+              </button>
+            </div>
+          </Dialog.Content>
+        </Dialog.Portal>
+      </Dialog.Root>
+    </section>
+  );
+}
+
+function Outcome({ outcome }: { outcome: CloseOutcome }) {
+  if (outcome.kind === "stale")
+    return (
+      <div
+        className="control-outcome refused"
+        role="alert"
+        data-testid="close-outcome"
+      >
+        <p>
+          <strong>Not sent: trade state changed.</strong>{" "}
+          {STALE_TEXT[outcome.reason]}
+          {outcome.detail ? ` (${outcome.detail})` : ""}
+        </p>
+      </div>
+    );
+  if (outcome.kind === "session")
+    return (
+      <div
+        className="control-outcome unknown"
+        role="alert"
+        data-testid="close-outcome"
+      >
+        <p>
+          <strong>Session ended.</strong>{" "}
+          {outcome.request
+            ? `Sign in again. The close request ${outcome.request.id} is kept; its outcome is unknown until retried with the same id.`
+            : "Sign in again. Nothing was sent."}
+        </p>
+      </div>
+    );
+  if (outcome.kind === "unknown")
+    return (
+      <div
+        className="control-outcome unknown"
+        role="status"
+        data-testid="close-outcome"
+      >
+        <p>
+          <strong>No answer — outcome unknown.</strong> The close may or may not
+          have been queued. The same request id ({outcome.request.id}) is kept;
+          retry resolves it without a second close.
+        </p>
+      </div>
+    );
+  const r = outcome.result;
+  return (
+    <div
+      className={`control-outcome ${r.disposition.toLowerCase()}`}
+      role="status"
+      data-testid="close-outcome"
+    >
+      <p>
+        <strong>close_trade: {r.status}</strong> · {r.disposition}
+        {r.replayed ? " · recorded result (replay)" : ""}
+      </p>
+      <p>{answerText(r)}</p>
+      <dl>
+        <dt>Kernel message</dt>
+        <dd>{r.message}</dd>
+        <dt>Reasons</dt>
+        <dd>{r.reasons.join(", ") || "—"}</dd>
+        <dt>Request</dt>
+        <dd>{r.requestId ?? outcome.request.id}</dd>
+        <dt>Audit events</dt>
+        <dd>{r.auditEventIds.join(", ") || "—"}</dd>
+      </dl>
+    </div>
+  );
+}
