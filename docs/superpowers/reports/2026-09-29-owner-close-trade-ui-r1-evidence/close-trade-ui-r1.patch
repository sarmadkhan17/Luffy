+def test_close_trade_ui_binding_exact_id_and_replay(tmp_path, ipc_dir):
+    """The React Close Trade binding: real dashboard route → IPC → OwnerService.
+
+    One journal id is queued, never its same-symbol sibling; an exact replay of
+    the browser's request id returns the recorded result without a second
+    queue entry; the same id with another trade is refused as a conflict."""
+    from trader.core.types import Position, Side
+    j, s = _plain_service(tmp_path, SlowResume(0))
+    for tid in ("pos_a", "pos_b"):             # two trades sharing one symbol
+        j.add_trade(Position(id=tid, symbol="UNI/USDT", side=Side.LONG, amount=1.0,
+                             entry_price=5.0, notional_usdt=5.0, stop_loss=4.5,
+                             market_type="futures", exec_mode="live",
+                             strategy_id="s", strategy_name="x"))
+    server = OwnerIPCServer(s, ipc_dir).start()
+    try:
+        client = _dashboard_app(tmp_path / "ipc.db", ipc_dir)
+        C = ("mutation($x:String!,$r:String!,$t:Float!){res:close_trade(trade_id:$x,"
+             "request_id:$r,issued_at_ms:$t)" + FIELDS + "}")
+        rid, t = str(uuid.uuid4()), time.time() * 1000      # browser randomUUID form
+        first = _gql(client, C, x="pos_a", r=rid, t=t)
+        assert first["status"] == "ACCEPTED" and first["replayed"] is False
+        assert first["reasons"] == ["close_queued_next_cycle"]
+        again = _gql(client, C, x="pos_a", r=rid, t=t)
+        assert again["status"] == "ACCEPTED" and again["replayed"] is True
+        assert again["audit_event_ids"] == first["audit_event_ids"]
+        assert json.loads(j.kv_get("close_requests")) == ["pos_a"]
+        assert len(j.query("SELECT id FROM control_events WHERE event='manual_close'")) == 1
+        # the same request id can never be reused for another trade
+        other = _gql(client, C, x="pos_b", r=rid, t=t)
+        assert other["status"] == "REFUSED" and other["reasons"] == ["request_id_conflict"]
+        assert json.loads(j.kv_get("close_requests")) == ["pos_a"]
+        # a fresh request for an already-queued trade queues nothing new
+        dup = _gql(client, C, x="pos_a", r=str(uuid.uuid4()), t=t)
+        assert dup["status"] == "ALREADY_SET"
+        assert json.loads(j.kv_get("close_requests")) == ["pos_a"]
+        # a trade that is no longer open is refused by the kernel, not queued
+        j.close_trade("pos_b", 5.5, 0.5, "sl_fill")
+        gone = _gql(client, C, x="pos_b", r=str(uuid.uuid4()), t=t)
+        assert gone["status"] == "REFUSED" and gone["reasons"] == ["trade_not_open"]
+        assert json.loads(j.kv_get("close_requests")) == ["pos_a"]
+    finally:
+        server.stop()
+
+
