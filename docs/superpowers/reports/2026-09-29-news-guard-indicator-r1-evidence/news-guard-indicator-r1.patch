+def read_news_guard(journal, now):
+    """The kernel's published News Guard result, read-only, never inferred.
+
+    Source: ``state_kv.news_guard_state``, written by ``Kernel.cycle`` every
+    cycle as ``{"active": bool, "why": str, "ts": iso}`` from
+    ``NewsGuard.check()``. ``ts`` is when the kernel published it; NewsGuard
+    re-reads its feed at most once per refresh window, so the evaluation may be
+    older than ``ts``. ``status`` maps only the exact ``why`` values
+    ``agents/news_guard.py`` produces. NewsGuard fails open (a feed error
+    publishes ``active: false``), so ``active: false`` is CLEAR only for its
+    two evaluated-quiet reasons:
+
+      ARMED         active: true. Orchestrator raises the entry threshold and
+                    dampens conviction; it does not block entries.
+      CLEAR         active: false after a successful evaluation.
+      DISABLED      active: false because the guard is disabled in config.
+      FAIL_OPEN     active: false because the feed check failed.
+      UNRECOGNIZED  active: false with any other reason — never CLEAR.
+
+    Missing → ``news_guard_state_missing``; anything but exactly those three
+    typed keys with a parseable time → ``news_guard_state_malformed``.
+    """
+    raw = journal.kv_get("news_guard_state")
+    if raw is None or raw == "":
+        return None, "news_guard_state_missing"
+    try:
+        d = json.loads(raw)
+    except (TypeError, ValueError):
+        return None, "news_guard_state_malformed"
+    if (not isinstance(d, dict) or set(d) != {"active", "why", "ts"}
+            or not isinstance(d["active"], bool) or not isinstance(d["why"], str)):
+        return None, "news_guard_state_malformed"
+    at = _parse(d["ts"])
+    if at is None:
+        return None, "news_guard_state_malformed"
+    why = d["why"]
+    age = _age(at, now)
+    freshness = ("invalid" if age < -CLOCK_SKEW_S
+                 else _freshness(max(age, 0.0), NEWS_GUARD_STALE_S))
+    if d["active"]:
+        status = "ARMED"
+    elif why == "disabled":
+        status = "DISABLED"
+    elif why.startswith("fetch error"):
+        status = "FAIL_OPEN"
+    elif _NEWS_CLEAR_WHY.fullmatch(why):
+        status = "CLEAR"
+    else:
+        status = "UNRECOGNIZED"
+    # NewsGuard journals a control event only when its armed state flips.
+    # Report it only when it agrees with the published state.
+    transition = None
+    rows = journal.query(
+        "SELECT id, ts, event, detail FROM (SELECT id, ts, event, detail FROM control_events "
+        "ORDER BY id DESC LIMIT ?) WHERE event IN ('news_blackout','news_clear') "
+        "ORDER BY id DESC LIMIT 1", (NEWS_GUARD_EVENT_WINDOW,))
+    if rows and (rows[0]["event"] == "news_blackout") == d["active"]:
