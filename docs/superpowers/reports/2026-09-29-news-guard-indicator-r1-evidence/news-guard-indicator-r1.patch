diff --git a/frontend/src/components/NewsGuard.tsx b/frontend/src/components/NewsGuard.tsx
new file mode 100644
index 0000000..b758658
--- /dev/null
+++ b/frontend/src/components/NewsGuard.tsx
@@ -0,0 +1,179 @@
+/** Read-only News Guard indicator. Shows the kernel's published NewsGuard
+ * result exactly as the owner API classified it; nothing here can change it.
+ * Only a fresh, unexpired CLEAR reads as clear. Missing, unreadable,
+ * off-contract, stale, fail-open and unrecognized readings never do. */
+import { timestamp as utc } from "../time";
+import { Badge } from "./ui";
+import type { NewsGuard } from "../adapters/contracts";
+
+type Tone = "mint" | "amber" | "rose";
+export interface NewsGuardView {
+  label: string;
+  tone: Tone;
+  /** One-line answer: is it armed, and is that current? */
+  summary: string;
+  /** false: this is not a current, authoritative reading. */
+  current: boolean;
+}
+
+export function newsGuardPresentation(
+  g: NewsGuard | null,
+  error: string | null,
+  now: number,
+): NewsGuardView {
+  if (!g)
+    return {
+      label: "UNAVAILABLE",
+      tone: "amber",
+      summary: `No readable News Guard state (${error ?? "not reported"}). Whether it is armed is unknown.`,
+      current: false,
+    };
+  if (g.freshness === "invalid")
+    return {
+      label: "UNKNOWN",
+      tone: "amber",
+      summary: `Published time ${utc(g.publishedAt)} is in the future; the reading is not trusted.`,
+      current: false,
+    };
+  if (
+    g.freshness !== "fresh" ||
+    g.expiresAt === null ||
+    !Number.isFinite(g.expiresAt) ||
+    now > g.expiresAt
+  )
+    return {
+      label: "STALE",
+      tone: "amber",
+      summary: `Last reported ${g.status} at ${utc(g.publishedAt)}; the kernel has not republished within ${g.staleAfterS}s, so the current state is unknown.`,
+      current: false,
+    };
+  switch (g.status) {
+    case "ARMED":
+      return {
+        label: "ARMED",
+        tone: "rose",
+        summary: `Armed: ${g.why}. Entries are dampened, not blocked.`,
+        current: true,
+      };
+    case "CLEAR":
+      return {
+        label: "CLEAR",
+        tone: "mint",
+        summary: `Not armed: ${g.why}.`,
+        current: true,
+      };
+    case "DISABLED":
+      return {
+        label: "DISABLED",
+        tone: "amber",
+        summary: "Disabled in config: no news protection is applied.",
+        current: true,
+      };
+    case "FAIL_OPEN":
+      return {
+        label: "FAIL-OPEN",
+        tone: "amber",
+        summary: `The feed check failed (${g.why}); the guard fails open and is not armed. News risk is unknown.`,
+        current: true,
+      };
+    default:
+      return {
+        label: "UNKNOWN",
+        tone: "amber",
+        summary: `Unrecognized reason "${g.why}": not treated as clear.`,
+        current: false,
+      };
+  }
+}
+
+export default function NewsGuardIndicator({
+  guard,
+  error,
+  now,
+  refreshError,
+  readAt,
+}: {
+  guard: NewsGuard | null;
+  error: string | null;
+  now: number;
+  /** The latest overview refresh failed; the reading shown is older. */
+  refreshError: boolean;
+  readAt: string | null;
+}) {
+  const v = newsGuardPresentation(guard, error, now);
+  return (
+    <div
+      className="news-guard"
+      data-testid="news-guard"
+      role="group"
+      aria-label="News Guard"
+    >
+      <span className="news-guard-head">
+        News Guard{" "}
+        <Badge tone={v.tone}>
+          <span data-testid="news-guard-status">{v.label}</span>
+        </Badge>{" "}
+        <span className="quiet">read-only</span>
+      </span>
+      <span data-testid="news-guard-summary">{v.summary}</span>
+      {refreshError && (
+        <span role="status" data-testid="news-guard-refresh-failed">
+          Latest refresh failed; this is the reading from {utc(readAt)}.
+        </span>
+      )}
+      {guard && (
+        <details>
+          <summary>News Guard evidence</summary>
+          <dl className="record-fields">
+            <div>
+              <dt>Published by kernel</dt>
+              <dd>
+                {utc(guard.publishedAt)} · {guard.freshness.toUpperCase()} ·
+                stale after {guard.staleAfterS}s
+              </dd>
+            </div>
+            <div>
+              <dt>Reason (kernel)</dt>
+              <dd>{guard.why || "—"}</dd>
+            </div>
+            <div>
+              <dt>Last recorded arm/clear event</dt>
+              <dd>
+                {guard.transition
+                  ? `${guard.transition.event} recorded ${utc(guard.transition.at)}`
+                  : "Not recorded in the recent control events"}
+              </dd>
+            </div>
+            {guard.transition?.headlines?.length ? (
+              <div>
+                <dt>Headlines recorded at that transition</dt>
+                <dd>
+                  <ul>
+                    {guard.transition.headlines.map((h, i) => (
+                      <li key={i}>{h}</li>
+                    ))}
+                  </ul>
+                </dd>
+              </div>
+            ) : null}
+            <div>
+              <dt>Until</dt>
+              <dd>
+                No expiry is recorded; the kernel re-evaluates on its refresh
+                interval.
+              </dd>
+            </div>
+            <div>
+              <dt>Effect while armed</dt>
+              <dd>{guard.effect}</dd>
+            </div>
+            <div>
+              <dt>Source</dt>
+              <dd>{guard.source}</dd>
+            </div>
+          </dl>
+        </details>
+      )}
+    </div>
+  );
+}
