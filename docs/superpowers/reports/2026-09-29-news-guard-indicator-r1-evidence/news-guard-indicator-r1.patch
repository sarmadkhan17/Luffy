+import { PreviewProvider } from "../src/context";
+import Overview from "../src/views/Overview";
+import type { OverviewData, OwnerAdapter } from "../src/adapters/contracts";
+
+/** LUFFY-NEWS-GUARD-INDICATOR-R1: the kernel's published NewsGuard result,
+ * read-only. Only a fresh, unexpired CLEAR ever reads CLEAR. */
+const iso = (ms: number) => new Date(ms).toISOString();
+const guard = (over: Record<string, unknown> = {}, at = Date.now()) => ({
+  status: "CLEAR",
+  active: false,
+  why: "feed quiet",
+  published_at: iso(at),
+  age_s: 3,
+  freshness: "fresh",
+  stale_after_s: 300,
+  transition: null,
+  effect:
+    "while armed: entry threshold +0.08 and conviction x0.75 (engine/orchestrator.py); entries are not blocked",
