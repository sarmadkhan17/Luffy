+"""News Guard indicator: /owner-api/v1/overview `news_guard` read contract.
+
+Observability only. The section reports the kernel's published NewsGuard
+result (state_kv.news_guard_state) and never infers or writes guard state.
+Unknown, missing, malformed, fail-open and stale are never CLEAR.
+"""
+import json
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+from tests.owner_frontend_fixture import FakeChat, TOKEN, make_app
+from trader.dashboard import owner_api
+
+H = {"x-luffy-token": TOKEN}
+
+
+@pytest.fixture
+def live(tmp_path, monkeypatch):
+    FakeChat.calls, FakeChat.mode = [], "ok"
+    app, journal, gateway = make_app(tmp_path, monkeypatch)
+    return TestClient(app), journal
+
+
+def _overview(c):
+    return c.get("/owner-api/v1/overview", headers=H).json()
+
+
+def _publish(journal, news, age_s=5.0):
+    """Exactly Kernel.cycle's publication of NewsGuard.check()."""
+    ts = datetime.now(timezone.utc) - timedelta(seconds=age_s)
+    journal.kv_set("news_guard_state", json.dumps(
+        {"active": bool(news.get("active")), "why": news.get("why", ""),
+         "ts": ts.isoformat()}))
+
+
+def _real_guard(monkeypatch, items=None, fail=False, enabled=True):
+    from trader.agents import news_guard as ng
+
+    def feed(url):
+        if fail:
+            raise OSError("feed timeout")
+        return items or []
+    monkeypatch.setattr(ng, "scrape_feed", feed)
+    return ng.NewsGuard({"scouts": {"news_guard": {"enabled": enabled}}}).check()
+
+
+HIT = {"title": "Fed holds interest rate", "text": "", "age_h": 0.5}
+SEVERE = {"title": "Exchange hacked for $40m", "text": "", "age_h": 0.2}
+
+
+@pytest.mark.parametrize("case, expect", [
+    ("armed_severe", "ARMED"), ("armed_two", "ARMED"), ("quiet", "CLEAR"),
+    ("one_impact", "CLEAR"), ("fetch_error", "FAIL_OPEN"), ("disabled", "DISABLED")])
+def test_status_maps_every_real_newsguard_output(live, monkeypatch, case, expect):
+    c, journal = live
+    news = {"armed_severe": lambda: _real_guard(monkeypatch, [SEVERE]),
+            "armed_two": lambda: _real_guard(monkeypatch, [HIT, dict(HIT, title="CPI day")]),
+            "quiet": lambda: _real_guard(monkeypatch, []),
+            "one_impact": lambda: _real_guard(monkeypatch, [HIT]),
+            "fetch_error": lambda: _real_guard(monkeypatch, fail=True),
+            "disabled": lambda: _real_guard(monkeypatch, enabled=False)}[case]()
+    _publish(journal, news)
+    o = _overview(c)
+    g = o["news_guard"]
+    assert g["status"] == expect and g["active"] is (expect == "ARMED")
+    assert g["freshness"] == "fresh" and g["why"] == news["why"]
+    assert g["source"].startswith("journal state_kv.news_guard_state")
+    assert "news_guard" not in o["errors"]
+
+
+def test_fixture_normal_scenario_publishes_clear(live):
+    o = _overview(live[0])
+    assert o["news_guard"]["status"] == "CLEAR" and o["errors"] == {}
+
+
+def test_missing_malformed_stale_invalid_are_never_clear(live):
+    c, journal = live
+    journal.kv_set("news_guard_state", "")
+    o = _overview(c)
+    assert o["news_guard"] is None and o["errors"]["news_guard"] == "news_guard_state_missing"
+    with journal._tx() as tx:
+        tx.execute("DELETE FROM state_kv WHERE key='news_guard_state'")
+    assert _overview(c)["errors"]["news_guard"] == "news_guard_state_missing"
+    now = datetime.now(timezone.utc).isoformat()
+    for bad in ("not json", "[]", "null",
+                json.dumps({"active": "false", "why": "", "ts": now}),
+                json.dumps({"active": 0, "why": "feed quiet", "ts": now}),
+                json.dumps({"active": False, "why": "feed quiet"}),
+                json.dumps({"active": False, "why": "feed quiet", "ts": "yesterday"}),
+                json.dumps({"active": False, "why": 3, "ts": now}),
+                json.dumps({"active": False, "why": "feed quiet", "ts": now, "x": 1})):
+        journal.kv_set("news_guard_state", bad)
+        o = _overview(c)
+        assert o["news_guard"] is None, bad
+        assert o["errors"]["news_guard"] == "news_guard_state_malformed", bad
+    _publish(journal, {"active": False, "why": "feed quiet"}, age_s=301)
+    g = _overview(c)["news_guard"]
+    assert (g["status"], g["freshness"], g["stale_after_s"]) == ("CLEAR", "stale", 300)
+    _publish(journal, {"active": False, "why": "feed quiet"}, age_s=-600)
+    assert _overview(c)["news_guard"]["freshness"] == "invalid"
+    _publish(journal, {"active": False, "why": "something new"})
+    assert _overview(c)["news_guard"]["status"] == "UNRECOGNIZED"
+
+
+def test_transition_reported_only_when_it_agrees(live):
+    c, journal = live
+    journal.log_control_event("news_blackout", "news_guard",
+                              detail={"hits": ["[severe] Exchange hacked"]})
+    _publish(journal, {"active": True, "why": "1 impact headlines (1 severe)"})
+    t = _overview(c)["news_guard"]["transition"]
+    assert t["event"] == "news_blackout" and t["headlines"] == ["[severe] Exchange hacked"]
+    assert t["at"] and isinstance(t["control_event_id"], int)
+    # CLEAR after the last recorded transition was an arm: "since" is unknown
+    _publish(journal, {"active": False, "why": "feed quiet"})
+    assert _overview(c)["news_guard"]["transition"] is None
+
+
+def test_read_only_no_control_path(live):
+    c, journal = live
+    before = journal.kv_get("news_guard_state")
+    events = journal.query("SELECT COUNT(*) n FROM control_events")[0]["n"]
+    _overview(c)
+    assert journal.kv_get("news_guard_state") == before
