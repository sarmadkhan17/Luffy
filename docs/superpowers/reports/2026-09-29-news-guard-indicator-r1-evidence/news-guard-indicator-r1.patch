+        except (TypeError, ValueError):
+            pass
+        transition = {"event": rows[0]["event"], "at": _iso(_parse(rows[0]["ts"])),
+                      "control_event_id": rows[0]["id"], "headlines": hits}
+    return {"status": status, "active": d["active"], "why": why[:200],
+            "published_at": _iso(at), "age_s": age, "freshness": freshness,
+            "stale_after_s": NEWS_GUARD_STALE_S, "transition": transition,
+            "effect": "while armed: entry threshold +0.08 and conviction x0.75 "
+                      "(engine/orchestrator.py); entries are not blocked",
