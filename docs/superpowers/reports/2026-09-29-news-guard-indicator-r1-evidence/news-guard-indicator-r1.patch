+import { test, expect, type Page } from "@playwright/test";
+import { LIVE, login, state } from "./liveHelpers";
+
+// LUFFY-NEWS-GUARD-INDICATOR-R1 — LIVE build over the real FastAPI app and a
+// temporary fixture journal. The fixture writes state_kv.news_guard_state the
+// way Kernel.cycle publishes NewsGuard.check(); "normal" publishes CLEAR.
+
+const status = (page: Page) => page.getByTestId("news-guard-status");
+const summary = (page: Page) => page.getByTestId("news-guard-summary");
+const box = (page: Page) => page.getByTestId("news-guard");
+
+test.beforeEach(async ({ request }) => {
+  await state(request, { scenario: "normal", fail: [], ttl: 43200 });
+});
+test.afterAll(async ({ request }) => {
+  await state(request, { scenario: "normal", fail: [], ttl: 43200 });
+});
+
+test("CLEAR renders from the kernel's publication, read-only", async ({
+  page,
+}) => {
+  const offOrigin: string[] = [];
+  const mutations: string[] = [];
+  page.on("request", (r) => {
+    if (new URL(r.url()).origin !== LIVE) offOrigin.push(r.url());
+    if (r.method() !== "GET" && r.url().endsWith("/graphql"))
+      mutations.push(r.postData() ?? "");
+  });
+  await login(page);
+  await expect(status(page)).toHaveText("CLEAR");
+  await expect(summary(page)).toHaveText("Not armed: feed quiet.");
+  await expect(box(page)).toContainText("read-only");
+  // nothing in the indicator can act: no button, input or form
+  await expect(
+    box(page).locator("button, input, select, textarea, form"),
+  ).toHaveCount(0);
+  await box(page).getByText("News Guard evidence").click();
+  await expect(box(page)).toContainText("journal state_kv.news_guard_state");
+  await expect(box(page)).toContainText("FRESH");
+  expect(mutations.filter((m) => m.includes("mutation"))).toEqual([]);
+  expect(offOrigin).toEqual([]);
+});
+
+test("ARMED shows why, the recorded transition and that entries are dampened, not blocked", async ({
+  page,
+  request,
+}) => {
+  await state(request, {
+    news_guard: {
+      active: true,
+      why: "3 impact headlines (1 severe)",
+      event: "news_blackout",
+      hits: ["[severe] Exchange hacked for $40m", "[impact] Fed holds rates"],
+    },
+  });
+  await login(page);
+  await expect(status(page)).toHaveText("ARMED");
+  await expect(summary(page)).toContainText(
+    "Armed: 3 impact headlines (1 severe). Entries are dampened, not blocked.",
+  );
+  await box(page).getByText("News Guard evidence").click();
+  await expect(box(page)).toContainText("news_blackout recorded");
+  await expect(box(page)).toContainText("[severe] Exchange hacked for $40m");
+  await expect(box(page)).toContainText("threshold +0.08");
+  await expect(box(page)).toContainText("No expiry is recorded");
+});
+
+for (const [name, spec, label, text] of [
+  ["missing", null, "UNAVAILABLE", "news_guard_state_missing"],
+  [
+    "malformed",
+    { raw: "{not json" },
+    "UNAVAILABLE",
+    "news_guard_state_malformed",
+  ],
+  [
+    "fail-open",
+    { active: false, why: "fetch error: timed out" },
+    "FAIL-OPEN",
+    "fails open and is not armed",
+  ],
+  [
+    "stale",
+    { active: false, why: "feed quiet", age_s: 900 },
+    "STALE",
+    "Last reported CLEAR",
+  ],
+  [
+    "unrecognized",
+    { active: false, why: "a new reason" },
+    "UNKNOWN",
+    "not treated as clear",
+  ],
+] as const)
+  test(`${name} state is ${label}, never CLEAR`, async ({ page, request }) => {
+    await state(request, { news_guard: spec });
+    await login(page);
+    await expect(status(page)).toHaveText(label);
+    await expect(summary(page)).toContainText(text);
+    await expect(status(page)).not.toHaveText("CLEAR");
+  });
+
+test("backend unavailable shows no guard reading at all", async ({
+  page,
+  request,
+}) => {
+  await state(request, { fail: ["/owner-api/v1/overview"] });
+  await login(page);
+  await expect(page.getByText(/Backend error 500/)).toBeVisible();
+  await expect(box(page)).toHaveCount(0);
+  await expect(page.getByText("CLEAR", { exact: true })).toHaveCount(0);
+});
+
+test("a failed refresh labels the older reading instead of passing it off as current", async ({
+  page,
+}) => {
+  await login(page);
+  await expect(status(page)).toHaveText("CLEAR");
+  await page.route("**/owner-api/v1/overview", (r) =>
+    r.fulfill({ status: 500, json: { error: "injected" } }),
+  );
+  // past the Overview's 10 s staleTime, returning to it refetches
+  await page.getByRole("link", { name: "Trades", exact: true }).click();
+  await page.waitForTimeout(10_500);
+  await page.getByRole("link", { name: "Overview", exact: true }).click();
+  await expect(page.getByTestId("news-guard-refresh-failed")).toBeVisible();
+  await expect(status(page)).toHaveText("CLEAR"); // labelled as older, expires locally
+});
+
+test("reload reads the kernel's current state; nothing is cached locally", async ({
+  page,
+  request,
+}) => {
+  await state(request, {
+    news_guard: { active: true, why: "1 impact headlines (1 severe)" },
+  });
+  await login(page);
+  await expect(status(page)).toHaveText("ARMED");
+  await state(request, { news_guard: { active: false, why: "feed quiet" } });
+  await page.reload();
+  await expect(status(page)).toHaveText("CLEAR");
+  await state(request, { news_guard: null });
+  await page.reload();
+  await expect(status(page)).toHaveText("UNAVAILABLE");
+});
+
+test("session expiry clears the guard reading", async ({ page, request }) => {
+  await state(request, { ttl: 6 });
+  await login(page);
+  await expect(status(page)).toHaveText("CLEAR");
+  await expect(page.getByTestId("signed-out")).toContainText(
+    "session expired",
+    {
+      timeout: 12000,
+    },
+  );
+  await expect(box(page)).toHaveCount(0);
+});
+
+test("the LIVE bundle carries no fixture fallback", async ({ page }) => {
+  const scripts: string[] = [];
+  page.on("response", async (r) => {
+    if (r.url().endsWith(".js")) scripts.push(await r.text());
+  });
+  await login(page);
+  await expect(status(page)).toHaveText("CLEAR");
+  expect(scripts.length).toBeGreaterThan(0);
+  for (const s of scripts) {
+    expect(s).not.toContain("Synthetic preview /");
+    expect(s).not.toContain("research receipt 001");
+  }
+});
