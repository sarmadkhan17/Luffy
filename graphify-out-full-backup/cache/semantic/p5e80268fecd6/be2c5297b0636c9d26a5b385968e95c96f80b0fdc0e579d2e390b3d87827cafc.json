{"nodes": [{"id": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design", "label": "Luffy Research Pipeline Design (Spec)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-11-luffy-research-pipeline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design", "label": "The research pipeline \u2014 discover, explain, prove, repeat", "file_type": "document", "source_file": "docs/superpowers/specs/2026-09-11-luffy-research-pipeline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosted as a kernel daemon thread but each batch runs in a nice-19, time-boxed child process: the kernel's pandas work holds the GIL and a crash in a search thread would take trading down. The child reads stores read-only and never writes the database."}, {"id": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design_search_ledger", "label": "Search ledger with canonical hashes", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-11-luffy-research-pipeline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every evaluated combination is recorded under a canonical hash whether kept or not, so a restart resumes rather than re-testing; held-out results never feed back into the search or they would silently become discovery data."}, {"id": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design_error_budget", "label": "LORD++ online FDR error budget", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-11-luffy-research-pipeline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A search over many combinations manufactures winners (1000 no-edge combinations pass ~10 at p<0.01), so every held-out look and prediction test spends from one budget; external claims draw from the same budget with no allowance for 'but this one is from a paper'."}, {"id": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design_reference_store", "label": "Reference store and ref() DSL marker", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-09-11-luffy-research-pipeline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bar exists only once it has closed in the source's own clock \u2014 aligning on the stamp would let every S&P signal see 6.5 hours ahead; missing is NaN rather than a carried value, and a stale reference reads UNTESTED, never a score."}], "edges": [{"source": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design", "target": "docs_superpowers_specs_2026_09_01_researcher_and_strategy_first_core_design", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-11-luffy-research-pipeline-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design", "target": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design_search_ledger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-11-luffy-research-pipeline-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design", "target": "docs_superpowers_specs_2026_09_11_luffy_research_pipeline_design_error_budget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-11-luffy-research-pipeline-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_11