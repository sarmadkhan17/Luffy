{"nodes": [{"id": "docs_superpowers_plans_2026_09_11_luffy_pays_rent", "label": "Luffy Pays Rent Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_core_journal_journal", "label": "Journal", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Journal writes go through _tx() (directly or via kv_set / log_brain_event / close_trade), never Journal.query(), which does not commit. close_trade ADDS pnl to realized_pnl \u2014 it is a leg, not a total."}, {"id": "trader_kernel_rent_loop", "label": "Kernel._rent_loop()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reports only \u2014 the verdict is Sarmad's to act on. Luffy never freezes, halts, stops or deletes anything because of a verdict."}, {"id": "config_rent", "label": "config.yaml rent block", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bar is $50 net per Monday-to-Monday UTC week and the first judged week starts 2026-09-14, so earlier weeks get a tally and never a verdict."}, {"id": "trader_engine_rent", "label": "Rent Ledger Module (trader/engine/rent.py)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On 2026-09-11 the journal booked 8 closes at +$46.33 where the venue's income ledger reads +$11.83, so nothing here reads trades. TRANSFER and any deposit is money moved in, not earned, and never counts. An unreadable ledger is UNKNOWN, never PASS; a readable week with zero rows is FAIL."}, {"id": "trader_engine_rent_week_bounds", "label": "rent.week_bounds()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_engine_rent_fetch_income", "label": "rent.fetch_income()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages forward from the last row's own timestamp, not one past it, so rows sharing a millisecond across a page break are kept; duplicates are dropped by (tranId, incomeType, symbol, time)."}, {"id": "trader_engine_rent_summarize", "label": "rent.summarize()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_engine_rent_read_week", "label": "rent.read_week()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns (None, error) on failure \u2014 None means UNKNOWN, never zero."}, {"id": "trader_engine_rent_verdict", "label": "rent.verdict()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_engine_rent_keeper", "label": "Rent Keeper Module (trader/engine/rent_keeper.py)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One verdict per week and restart-safe: an UNKNOWN verdict is superseded by a later rent_verdict row marked correction, and the latest row per week wins. It never stops, freezes or deletes anything \u2014 the verdict is the operator's to act on."}, {"id": "trader_engine_rent_keeper_rentkeeper", "label": "RentKeeper", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_engine_rent_keeper_tick", "label": "RentKeeper.tick()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_engine_rent_keeper_snapshot", "label": "rent_keeper.snapshot()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_engine_rent_keeper_status_text", "label": "rent_keeper.status_text()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_engine_executor_close", "label": "Executor.close()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Binance Demo market order comes back with neither average nor price, so booking order[average] or order[price] or hint booked the caller's hint \u2014 8 of 8 exits on 2026-09-11 were journalled better than they filled. Reduce-only fills only what the venue still holds, so pricing the exit over the journalled size would invent coins of P&L out of rounding."}, {"id": "trader_engine_executor_close_partial", "label": "Executor.close_partial()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The entry commission is settled when the final close re-bases the trade to the venue's total, not on each partial leg."}, {"id": "trader_engine_executor_order_fills", "label": "Executor._order_fills()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_engine_executor_pnl_window_start", "label": "Executor._pnl_window_start()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The entry fill lands seconds before opened_at is stamped, so reading from opened_at would drop the entry commission; the window looks back 30s but is clamped so it never reaches into the previous trade on the same symbol."}, {"id": "trader_engine_reconcile_venue_realized_pnl", "label": "reconcile.venue_realized_pnl()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-11-luffy-pays-rent.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the sum of info.realizedPnl minus info.commission over fetch_my_trades, so the journal and the venue cannot disagree."}, {"id": "trader_api_graphql_schema_rent", "label": "GraphQL rent field", 