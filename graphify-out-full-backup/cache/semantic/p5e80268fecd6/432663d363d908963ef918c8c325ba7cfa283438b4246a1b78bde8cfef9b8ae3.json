{"nodes": [{"id": "docs_superpowers_plans_2026_08_31_strategy_foundation", "label": "Strategy Foundation Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "strategy_spec", "label": "StrategySpec", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces Genome whose family+params shape forced every scraped idea into one of eight templates and read exit geometry from global config."}, {"id": "exit_spec", "label": "ExitSpec", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "feature_registry", "label": "Feature Registry (FEATURES)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Novelty scales directly with what is in this file: a strategy can only express a mechanism whose observables are registered here."}, {"id": "feature_ctx", "label": "FeatureCtx", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "dsl", "label": "Strategy Expression DSL", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Security boundary: ast.parse + node whitelist, no exec, eval, attribute access, subscripts, comprehensions, lambdas, or keyword arguments."}, {"id": "vector_backtest", "label": "Vector Backtest Engine", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Produces vectorized boolean entry arrays and iterates only sparse entry indices; must reproduce simulate exactly."}, {"id": "genome", "label": "Genome (legacy strategy representation)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_superpowers_plans_2026_08_31_strategy_foundation", "label": "Strategy Foundation Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_dsl", "label": "DSL Module (trader/strategy/dsl.py)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A restricted Python expression parsed against a node whitelist with no code execution path; the same text is what the Librarian prints on a vault card, so the strategy a human reads and the strategy the backtester runs cannot drift apart. Replaces the exec() sandbox."}, {"id": "trader_strategy_dsl_parse", "label": "parse()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_dsl_specerror", "label": "SpecError", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_dsl_features_used", "label": "features_used()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_dsl_data_requires", "label": "data_requires()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DERIVED, never declared: a Strategist cannot claim a spec is OHLCV-only while reading funding, so the gauntlet can always tell whether the data to test it honestly actually exists."}, {"id": "trader_strategy_dsl_eval", "label": "_eval()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_dsl_evaluate", "label": "evaluate()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_dsl_evaluate_bool", "label": "evaluate_bool()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NaN \u2014 an indicator still warming up, or missing leader/derivative data \u2014 is FALSE, never a firing signal."}, {"id": "trader_strategy_dsl_eval_htf", "label": "_eval_htf()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same discipline as backtest.ctx_at(): searchsorted with side=right minus one, so a base bar can only see HTF bars already complete."}, {"id": "trader_strategy_dsl_literal", "label": "Literal dataclass", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every numeric literal is automatically a parameter with a range inferred from the feature registry \u2014 this is why there is no FAMILY_GENE_SPECS."}, {"id": "trader_strategy_dsl_extract_literals", "label": "extract_literals()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_dsl_apply_literals", "label": "apply_literals()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integer-typed literals are rounded so a period stays a period; returns a new tree rather than mutating."}, {"id": "trader_strategy_dsl_render", "label": "render()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This text is what the Librarian prints, so it must always re-parse."}, {"id": "trader_strategy_features_features", "label": "FEATURES registry", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_features_deriv", "label": "Derivative Features Module (trader/strategy/features_deriv.py)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_features_deriv_align", "label": "align()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bar at time t may only see observations STRICTLY BEFORE t: an observation stamped exactly t is knowable only after t, so side=left is used rather than side=right which would leak. Missing data is NaN, never a neutral default \u2014 a fabricated 0.0 funding rate reads as flat funding and would fire signals on data that does not exist."}, {"id": "trader_strategy_compile", "label": "Compiler Module (trader/strategy/compile.py)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One artifact, three consumers (Analyst vectorized arrays, Trader live evaluator, Librarian readable card), no drift."}, {"id": "trader_strategy_compile_compile_spec", "label": "compile_spec()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parse every expression up front: a spec that cannot compile must never reach the gauntlet, let alone the book."}, {"id": "trader_strategy_compile_compiledstrategy", "label": "CompiledStrategy", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bar cannot be both long and short; direction conflicts resolve to no trade."}, {"id": "trader_strategy_vector_backtest", "label": "Vectorized Backtester (trader/strategy/vector_backtest.py)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old engine called a Python evaluator once per bar at ~1.9 ms/bar/symbol, so a 5-symbol x 8000-bar gauntlet cost ~76 s inside a 300 s tick capped at two candidates; here the entry signal is a boolean array computed once and only trade-open bars are touched."}, {"id": "trader_strategy_vector_backtest_simulate", "label": "simulate()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fill and accounting model is copied from backtest.py deliberately \u2014 identical pessimism (stop before target when both are touched intrabar) and identical fee/slippage/funding arithmetic \u2014 so the equivalence harness can attribute any difference to the new exit geometry rather than to an accounting change."}, {"id": "trader_strategy_vector_backtest_vector_backtest", "label": "vector_backtest()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_vector_backtest_vector_walk_forward", "label": "vector_walk_forward()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signals are computed ONCE over the full frame and then sliced, so an indicator near the split boundary is warmed up exactly as it would be live \u2014 the old engine re-ran the evaluator on a truncated frame and cost the test half its first 210 bars. Same contract as backtest.walk_forward so evidence.py can call either."}, {"id": "trader_strategy_backtest_backtest", "label": "backtest() (legacy engine)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old engine is the reference for the equivalence test even where its behaviour is imperfect, because the point is to isolate the change."}, {"id": "trader_strategy_backtest_backtestresult", "label": "BacktestResult", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_spec_strategyspec", "label": "StrategySpec", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_strategy_spec_exitspec", "label": "ExitSpec", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exit geometry belongs to the spec rather than being inherited from a global 2.5/4.5/32 default, so exits must matter in the backtest."}, {"id": "trader_strategy_seed_specs_load_seed_specs", "label": "load_seed_specs()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seed specs exist so the equivalence harness has something to compare and the book is never empty; they are not the interesting output of the system."}, {"id": "trader_agents_indicators", "label": "indicators module (trader/agents/indicators.py)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_data_derivatives_derivfeed", "label": "DerivFeed", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OHLCV can only yield strategies that have been invented a million times; crypto-native mechanisms need this data. Retention is asymmetric \u2014 funding and basis have years, while oi/taker/long-short retain only ~30 days, so the recorder runs from day one and history accumulates past the API window."}, {"id": "trader_kernel", "label": "Kernel (trader/kernel.py)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "trader_kernel_derivatives_recorder", "label": "Kernel._derivatives_recorder()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs from day one even though nothing reads it yet: the OI, taker and long-short endpoints retain only ~30 days, so history not recorded now is permanently unavailable to any future backtest."}, {"id": "scripts_backtest_equivalence_engine_equivalence", "label": "engine_equivalence()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The gate that makes the cutover evidence-based rather than faith-based: feed both backtesters identical entry signals and identical exit geometry and require identical trades, so any difference is an accounting bug and not a strategy difference."}, {"id": "scripts_backtest_equivalence_signal_equivalence", "label": "signal_equivalence()", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deltas here are expected for families whose Python logic is not expressible one-to-one; they are REPORTED, not asserted away \u2014 anything below 0.98 needs a one-line explanation of why the port differs."}, {"id": "scripts_bench_vector_backtest", "label": "bench_vector_backtest.py", "file_type": "code", "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target is at least 20x; the design point is ~100x. Exit code 1 below 20x."}], "edges": [{"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "strategy_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "exit_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "feature_registry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "dsl", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "compile_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "vector_backtest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "derivatives_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "genome", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_31_strategy_foundation", "target": "orchestrator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-31-strategy-foundation.md", "source_locatio