ence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_runner_researchrunner", "target": "trader_research_control_label", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_runner_researchrunner", "target": "trader_research_control_incumbent_universe", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_runner_researchrunner", "target": "trader_research_ledger_ledger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_runner_researchrunner", "target": "config", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_kernel_research_loop", "target": "trader_research_runner_researchrunner", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_main", "target": "trader_research_runner_researchrunner", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_growth_earns_place", "target": "concept_consistency_p", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_control_label", "target": "concept_underpowered_label", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_evaluate_load_bundle", "target": "concept_discovery_slice", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}, {"source": "trader_research_runner_researchrunner", "target": "trader_research_ledger_ledger", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-12-research-phase2-search.md", "source_location": null, "weight": 1.0}], "hyperedges": []}