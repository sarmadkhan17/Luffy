{"nodes": [{"id": "docs_superpowers_plans_2026_09_18_collector_recovery_health_brief", "label": "Collector Recovery-Aware Health \u2014 Implementation Brief (Revision 2)", "file_type": "document", "source_file": "docs/superpowers/plans/2026-09-18-collector-recovery-health-brief.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The fix keeps every refusal of a present failure and adds an exact recovery certificate tied to scan identity; it does not remove the errors check and does not accept on status alone."}, {"id": "trader_observability_collector", "label": "trader/observability/collector.py", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-18-collector-recovery-health-brief.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The producer does O(1) work with no I/O, no waiting and no new locks; the failure signal is published by one atomic tuple reference assignment."}, {"id": "trader_observability_worker", "label": "trader/observability/worker.py", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-18-collector-recovery-health-brief.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the worker thread writes the health file; a pending producer-generation change must prevent certificate publication \u2014 never advertise a stronger guarantee than is held."}, {"id": "trader_observability_collector_health", "label": "trader/observability/collector_health.py", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-18-collector-recovery-health-brief.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This predicate replaces the inline checks in learning.py, investigation.py and store.read_latest; a schema string alone proves nothing, so required fields, counter consistency and certificate structure are validated."}, {"id": "trader_observability_learning", "label": "trader/observability/learning.py", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-18-collector-recovery-health-brief.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "While refusing, emit a gap receipt with the specific reason code; on the first acceptance after a refusal, emit one collector_outage gap."}, {"id": "trader_observability_store", "label": "trader/observability/store.py", "file_type": "code", "source_file": "docs/superpowers/plans/2026-09-18-collector-recovery-health-brief.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persist the instance UUID and sequence in the scan payload and cause-event metadata; these are new versioned metadata fields, not rewritten source availability clocks or a backfill."}, {"id": "concept_recovery_certificate", "label": "Recovery certificate", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-18-collector-recovery-health-brief.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issued only after 2 consecutive complete scans past the fence, no intervening failure, and 300 s since the last error \u2014 conservative engineering defaults, not statistically derived; any new failure invalidates it."}], "edges": [{"source": "trader_observability_investigation", "target": "trader_observability_collector_health", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-09-18-collector-recovery-health-brief.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_18_collector_recovery_health_brief", "target": "trader_observability_collector", "relation": "ref