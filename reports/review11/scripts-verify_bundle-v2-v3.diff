+                rows, lookup = own_rows(y, o, x, pi, B, RPB)
+                signed, ok = fm.statistics(np.asarray(pi))
+                for h in range(mem.shape[1]):
+                    got = _metric(rows, {ids[i] for i in np.flatnonzero(mem[:, h])}, labels[h], lookup).get("signed_effect")
