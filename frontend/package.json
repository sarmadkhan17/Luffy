{
  "name": "luffy-owner-frontend-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort --mode demo",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir .demo-dist",
    "preview": "vite build --mode demo --outDir .demo-dist && vite preview --mode demo --outDir .demo-dist --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.104.0",
    "@xyflow/react": "12.12.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
