 "dgp_baseline": {
  "cell": "Y[b,s,t] = nuis_y(b) + delta*SD_UNIT*x_b + lambda_s*f[b,t] + e[b,s,t] (+ jump_b in shocks)",
  "feature": "x_b = nuis_x(b) + N(0,1)",
  "lambda_s": [
   0.6,
   0.6533333333333333,
   0.7066666666666667,
   0.76,
